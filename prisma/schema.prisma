datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  email             String?            @unique
  passwordHash      String
  balance           Float              @default(0.0)
  points            Int                @default(0)
  role              String             @default("USER")
  orders            Order[]
  transactions      Transaction[]
  couponUsages      CouponUsage[]
  wishlistItems     WishlistItem[]
  reviews           ProductReview[]
  notifications     Notification[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  pointTransactions PointTransaction[]
  orderAuditLogs    OrderAuditLog[]
  priceHistories    ProductPriceHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id                String             @id @default(cuid())
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  price             Float
  originalPrice     Float?
  thumbnail         String
  type              String             @default("ACCOUNT_PURCHASE") // ACCOUNT_PURCHASE | FARMING_SERVICE
  lowStockThreshold Int                @default(3)
  stocks            StockItem[]
  orders            Order[]
  luckyBoxRewards   LuckyBoxReward[]
  wishlistItems     WishlistItem[]
  reviews           ProductReview[]
  promotionProducts PromotionProduct[]
  priceHistories    ProductPriceHistory[]
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
}

model StockItem {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  accountData String
  isSold      Boolean   @default(false)
  soldAt      DateTime?
  orderId     String?   @unique
  order       Order?    @relation(fields: [orderId], references: [id])
  createdAt   DateTime  @default(now())
}

model LuckyBox {
  id          String           @id @default(cuid())
  name        String
  description String?
  price       Float
  thumbnail   String
  isActive    Boolean          @default(true)
  rewards     LuckyBoxReward[]
  orders      Order[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model LuckyBoxReward {
  id        String   @id @default(cuid())
  boxId     String
  box       LuckyBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  name      String
  type      String   // POINT | CREDIT | ACCOUNT | LOSE
  value     String   // e.g. "100" for credit, "50" for points, or custom desc
  dropRate  Float    // percentage or weight, e.g. 10.0
  productId String?  // optional relation to Product for pulling stock accounts
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Order {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  luckyBoxId     String?
  luckyBox       LuckyBox?       @relation(fields: [luckyBoxId], references: [id])
  type           String          // ACCOUNT_PURCHASE | FARMING_SERVICE | LUCKY_BOX
  status         String          @default("PAID") // PENDING | PAID | PROCESSING | DELIVERED | COMPLETED | CANCELLED | REFUNDED
  priority       String          @default("NORMAL") // NORMAL | HIGH | URGENT
  totalAmount    Float
  discountAmount Float           @default(0.0)
  couponId       String?
  coupon         Coupon?         @relation(fields: [couponId], references: [id])
  stockItem      StockItem?
  customerInput  String?
  adminNote      String?
  couponUsages   CouponUsage[]
  auditLogs      OrderAuditLog[]
  tickets        Ticket[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderAuditLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String   // STATUS_CHANGE | REFUND | PRIORITY_CHANGE | NOTE_UPDATE
  oldStatus String?
  newStatus String?
  note      String?
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  channel     String   // PROMPTPAY | TRUEMONEY_VOUCHER | REFUND
  referenceNo String?  @unique
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt   DateTime @default(now())
}

model Coupon {
  id           String        @id @default(cuid())
  code         String        @unique
  type         String        @default("PERCENT") // PERCENT | FIXED
  value        Float
  minSpend     Float?
  maxDiscount  Float?
  usageLimit   Int?
  usageCount   Int           @default(0)
  perUserLimit Int           @default(1)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean       @default(true)
  orders       Order[]
  usages       CouponUsage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model Promotion {
  id              String             @id @default(cuid())
  title           String
  description     String?
  discountPercent Float              @default(10.0)
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean            @default(true)
  products        PromotionProduct[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model PromotionProduct {
  id            String    @id @default(cuid())
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPrice Float?
  createdAt     DateTime  @default(now())

  @@unique([promotionId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ProductReview {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  isHidden           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // ORDER_CREATED | ORDER_PAID | ORDER_COMPLETED | FARMING_STATUS | TOPUP_SUCCESS | LUCKY_BOX_WIN | PROMOTION | SYSTEM | REFUND
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id])
  subject   String
  category  String          @default("OTHER") // ORDER | PAYMENT | ACCOUNT | FARMING | LUCKY_BOX | OTHER
  priority  String          @default("NORMAL") // NORMAL | HIGH | URGENT
  status    String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING_USER | RESOLVED | CLOSED
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  senderRole String   @default("USER") // USER | ADMIN
  message    String
  createdAt  DateTime @default(now())
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Float
  newPrice  Float
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String   // PURCHASE | LUCKY_BOX | BONUS | REDEEM | ADMIN_ADJUSTMENT
  description String?
  createdAt   DateTime @default(now())
}

model RewardItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String
  pointCost   Int
  rewardType  String   // CREDIT | COUPON | DISCOUNT
  rewardValue String
  stock       Int      @default(999)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}